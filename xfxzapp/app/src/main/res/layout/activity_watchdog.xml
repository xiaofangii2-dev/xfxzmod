<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#C8E6C9"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTpsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/btnTpsToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启/关闭 TPS 看门狗"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="?android:attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/btnTpsThreshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置 TPS 阈值"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="?android:attr/selectableItemBackground"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#999999"/>

    <TextView
        android:id="@+id/tvMsptStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/btnMsptToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启/关闭 MSPT 看门狗"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="?android:attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/btnMsptThreshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置 MSPT 阈值"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="?android:attr/selectableItemBackground"/>
</LinearLayout>
