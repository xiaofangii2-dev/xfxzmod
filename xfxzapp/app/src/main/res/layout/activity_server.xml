<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C8E6C9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:paddingTop="32dp">
            
            <LinearLayout android:id="@+id/pageHome" android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:padding="8dp"/>
                <TextView android:id="@+id/tvPlayers" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:padding="8dp"/>
                <TextView android:id="@+id/tvUptime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:padding="8dp"/>
                <TextView android:id="@+id/tvTps" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:padding="8dp"/>
                <TextView android:id="@+id/tvMspt" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:padding="8dp"/>
                <TextView android:id="@+id/tvMemory" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:padding="8dp"/>
            </LinearLayout>

            <!-- 玩家页面增加空状态 -->
            <FrameLayout android:id="@+id/pagePlayers" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
                <ListView android:id="@+id/lvPlayers" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:divider="#A5D6A7" android:dividerHeight="1dp"/>
                <TextView android:id="@+id/tvNoPlayers" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:text="没有玩家" android:textSize="18sp" android:textColor="#666666"
                    android:gravity="center" android:visibility="gone"/>
            </FrameLayout>

            <LinearLayout android:id="@+id/pagePlugin" android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
                    <Button android:id="@+id/btnPluginAdd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="下载插件" android:backgroundTint="#66BB6A" android:layout_alignParentStart="true"/>
                </RelativeLayout>
                <ListView android:id="@+id/lvPlugins" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:divider="#A5D6A7" android:dividerHeight="1dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/pageRcon" android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <EditText android:id="@+id/etRcon" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="输入命令"/>
                <Button android:id="@+id/btnRconSend" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="发送"/>
                <TextView android:id="@+id/tvRconResult" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="14sp" android:padding="8dp"/>
            </LinearLayout>

            <ScrollView android:id="@+id/pageSettings" android:layout_width="match_parent"
                android:layout_height="match_parent" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/btnGithub" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="关于" android:textSize="16sp"
                        android:padding="16dp" android:background="?android:attr/selectableItemBackground"/>
                    <TextView android:id="@+id/btnVersion" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="版本" android:textSize="16sp"
                        android:padding="16dp" android:background="?android:attr/selectableItemBackground"/>
                    <TextView android:id="@+id/btnDevMode" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="关闭开发者模式" android:textSize="16sp"
                        android:padding="16dp" android:visibility="gone" android:background="?android:attr/selectableItemBackground"/>
                    <TextView android:id="@+id/btnWatchdogEntry" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="看门狗" android:textSize="16sp"
                        android:padding="16dp" android:visibility="gone" android:background="?android:attr/selectableItemBackground"/>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemIconTint="#43A047"
            app:itemTextColor="#2E7D32"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</FrameLayout>
