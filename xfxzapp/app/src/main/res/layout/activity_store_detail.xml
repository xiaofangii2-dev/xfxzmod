<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#C8E6C9" android:padding="24dp">

    <!-- 增加顶部间距往下挪 (这里改成了 120dp) -->
    <Space android:layout_width="match_parent" android:layout_height="120dp" />

    <TextView android:id="@+id/tvDetailName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="28sp" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="16dp"/>
        
    <TextView android:id="@+id/tvDetailDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="暂无描述" android:textSize="16sp" android:textColor="#666666" android:layout_marginBottom="48dp"/>
        
    <Button android:id="@+id/btnDownload" android:layout_width="match_parent" android:layout_height="56dp"
        android:text="下载插件" android:textSize="18sp" android:backgroundTint="#66BB6A"/>
</LinearLayout>
